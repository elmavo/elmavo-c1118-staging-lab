{
  "name": "elmavo-stg-c1118-collector",
  "account_id": "00000000000000000000000000000000",
  "main": "./cloud-collector.mjs",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "preview_urls": false,
  "placement": {
    "region": "aws:eu-central-1"
  },
  "observability": {
    "enabled": false
  },
  "vars": {
    "ENTRY_ENABLED": "0",
    "C1118_COLLECTOR_ENABLED": "0",
    "SYNTHETIC_ONLY": "1",
    "ACCOUNT_ID": "00000000000000000000000000000000",
    "DATABASE_ID": "00000000-0000-4000-8000-000000000001",
    "INSTALLATION_ID": "00000000-0000-4000-8000-000000000002",
    "RUN_ID": "UNSET",
    "PUBLIC_RUN_PLAN": "UNSET"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SAFETY",
        "class_name": "C1118SafetyLedger",
        "script_name": "elmavo-stg-c1118-safety"
      }
    ]
  }
}
